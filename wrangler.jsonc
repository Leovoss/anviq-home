{
  "name": "anviq-home",
  "account_id": "e9027d8558f91d1adb2fa970b3375c2c",
  "compatibility_date": "2026-09-10",
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "REACTIONS",
      "id": "8394c13e5fba4f54a79d1c8b0a9b2bf4"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
